# Copier en .env si vous voulez changer les valeurs par défaut.
# La configuration des connecteurs se fait dans l'interface, pas ici.

TZ=Europe/Paris
LOG_LEVEL=INFO

# Clé de chiffrement des credentials stockés en base (ADR-005).
# Laisser vide : elle est générée dans /data/secret.key au premier démarrage.
# Si vous la définissez, conservez-la : sans elle, les credentials enregistrés
# sont irrécupérables.
AWTRIXNG_SECRET_KEY=

# Valeur INITIALE de la langue des horloges : conditions météo, phases de lune,
# décomptes. "en" ou "fr".
#
# Ce réglage se change aussi dans l'interface — page Afficheurs,
# au-dessus de la liste — et ce qui y est choisi l'emporte sur cette ligne.
# Elle ne sert donc qu'à la première mise en route.
#
# Ce n'est PAS la langue de l'interface, que chaque navigateur choisit de son
# côté : une horloge n'a pas de navigateur à qui demander, le planificateur
# pousse à trois heures du matin.
AWTRIXNG_LANGUAGE=fr

# Mot de passe de l'interface (ADR-019).
# Laisser vide : aucune authentification, comportement historique.
# Le renseigner ferme toutes les routes sauf /api/health.
# Rappel : la sauvegarde exporte les credentials en clair (ADR-018).
AWTRIXNG_PASSWORD=

# Cookie de session marqué Secure. À true derrière Caddy (HTTPS) ; false pour
# un accès en HTTP direct, sinon le navigateur jette le cookie et la connexion
# échoue sans message.
#
# Sans fichier .env, la valeur par défaut est false — ce qui fait marcher une
# première mise en route en HTTP. Ce fichier la met à true parce qu'il décrit
# l'installation recommandée.
AWTRIXNG_SECURE_COOKIE=true

# Jeton de lecture pour un tableau de bord (Homepage, etc.).
# Il n'ouvre que /api/summary — ni sauvegarde, ni modification, ni réglage.
# Laisser vide : aucun jeton n'est accepté.
#   openssl rand -hex 24
AWTRIXNG_API_TOKEN=

# Afficheurs que les outils en ligne de commande et les tests matériels
# doivent REFUSER d'écrire. Séparés par des virgules, noms ou adresses.
#
# Vide par défaut, et c'est voulu : une liste pleine des noms de quelqu'un
# d'autre ne protège personne tout en ayant l'air de protéger.
#
# À remplir le jour où vous en avez deux. Celle sur laquelle vous essayez des
# choses et celle que la maison regarde sont le même modèle, répondent à la
# même API, et ne diffèrent que d'un caractère.
#   AWTRIXNG_PROTECTED_HOSTS=awtrix-salon,awtrix-salon.lan
#
# Ce réglage est aussi lu depuis un .env à la racine d'une COPIE DE TRAVAIL,
# et pas seulement par Docker Compose. Les outils qui écrivent le plus sur une
# dalle — le banc d'essai, l'extracteur de police, les tests matériels —
# tournent sur un poste de développement et non dans le conteneur : sans cela,
# la liste protégeait la moitié qui n'a jamais été le danger.
AWTRIXNG_PROTECTED_HOSTS=
